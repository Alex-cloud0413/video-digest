{
  "manifest_version": 3,
  "name": "YT Digest",
  "version": "1.1.0",
  "description": "AI-powered YouTube video digests — know what's worth watching before you watch it.",
  "permissions": [
    "sidePanel",
    "activeTab",
    "storage",
    "tabs",
    "scripting"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://api.supadata.ai/*",
    "https://api.anthropic.com/*",
    "https://api.assemblyai.com/*",
    "https://api.deepseek.com/*",
    "https://api.qwkuns.me/*",
    "https://api.dl.woof.monster/*",
    "https://api.cobalt.liubquanti.click/*",
    "https://api.kektube.com/*",
    "https://cobaltapi.cjs.nz/*",
    "https://*.googlevideo.com/*"
  ],
  "action": {
    "default_title": "Open YT Digest",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
